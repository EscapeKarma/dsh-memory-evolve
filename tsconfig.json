{
  // 编辑器类型提示用的第三方类型入口（不参与构建：esbuild 打包时不读 tsconfig 的 paths）。
  //
  // 这里只指向本仓库内的相对位置，避免把某个人的本机路径写进仓库：
  // 需要类型提示时，把你本地的 DSH 源码 checkout 软链成仓库根下的 `.dsh-source/`，
  // 例如：mklink /D .dsh-source D:\src\deepseek-harness   （Windows）
  //       ln -s ~/src/deepseek-harness .dsh-source        （macOS / Linux）
  // 目录不存在时 TypeScript 会报找不到这些模块的类型，但 `node scripts/build.mjs`
  // 与全部测试都不受影响。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "react": [
        ".dsh-source/node_modules/.pnpm/@types+react@18.3.31/node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        ".dsh-source/node_modules/.pnpm/@types+react@18.3.31/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "cordis": [
        ".dsh-source/vendor/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        ".dsh-source/packages/client/ui-slots/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-conversation/client": [
        ".dsh-source/packages/client/ui-conversation/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        ".dsh-source/packages/client/locale/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-runtime/client": [
        ".dsh-source/packages/client/runtime/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        ".dsh-source/packages/client/ui-primitives/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-web-react": [
        ".dsh-source/packages/client/web-react/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-settings/client": [
        ".dsh-source/packages/client/ui-settings/lib/types/client/index.d.ts"
      ]
    }
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
