{
  "name": "@escapekarma49/dsh-memory-evolve",
  "version": "0.7.2",
  "description": "为 DeepSeek Harness 带来分层记忆（全局 / 用户 / 项目 / GIT 分支 / 每日）与自我进化（经验沉淀 + 技能自动创建）和技能管理、待办管理、CLI 调度（kimi/codex/grok/hermes 等外部 AI 统一调度）、临时信息便签，带 WebUI 管理界面。Hermes-style long-term memory, self-evolution, skills, todos and external CLI agent dispatch for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "test:win": "node scripts/test-win.mjs",
    "build": "node scripts/build.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "push": "node scripts/push.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "EscapeKarma",
    "url": "https://github.com/EscapeKarma"
  },
  "contributors": [
    {
      "name": "csyangwen (original author)",
      "url": "https://github.com/csyangwen/dsh-memory-evolve"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EscapeKarma/dsh-memory-evolve.git"
  },
  "homepage": "https://github.com/EscapeKarma/dsh-memory-evolve#readme",
  "bugs": {
    "url": "https://github.com/EscapeKarma/dsh-memory-evolve/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "skills",
    "todo",
    "agent"
  ],
  "files": [
    "lib/",
    "scripts/",
    "skills/",
    "vendor/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README-详细说明.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  }
}
